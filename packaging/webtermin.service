[Unit]
Description=webtermin server control panel
Documentation=https://github.com/Satan1an/webtermin
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/webtermin -config /etc/webtermin/config.yaml
# Default: run as root because most actions (systemctl / useradd / chpasswd /
# arbitrary file writes) need it. To run as an unprivileged user instead, drop
# packaging/sudoers.webtermin into /etc/sudoers.d/, create the `webtermin`
# system user, override these two lines (e.g. via `systemctl edit webtermin`)
# to `User=webtermin` / `Group=webtermin`, and add the user to the `docker`
# group if you use the Docker module. See SECURITY.md for the full trade-off.
User=root
Group=root
Restart=on-failure
RestartSec=3
# Surface stdout/stderr in journal.
StandardOutput=journal
StandardError=journal

# Minimal hardening that doesn't conflict with the panel's job:
# - prevent the panel binary from gaining new privileges via setuid helpers it spawns
NoNewPrivileges=false
# - hide other processes' details (panel still sees full PIDs from D-Bus)
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=false
# Note: we intentionally do NOT set ProtectSystem=full or ProtectHome — the
# panel manages /etc and /home, so those must stay writable.

[Install]
WantedBy=multi-user.target
