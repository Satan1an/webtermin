#!/bin/sh
# webtermin .deb pre-removal hook.
set -e

case "$1" in
    remove|upgrade|deconfigure)
        if command -v systemctl >/dev/null 2>&1; then
            systemctl stop webtermin.service >/dev/null 2>&1 || true
            if [ "$1" = "remove" ]; then
                systemctl disable webtermin.service >/dev/null 2>&1 || true
            fi
        fi
        ;;

    failed-upgrade)
        ;;
esac

exit 0
